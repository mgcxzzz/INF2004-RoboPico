+/* ---------- G: v0.4 stall push ---------- */
+typedef struct { int pushes, ends, end_reason, bad_range, bad_slew; float push_max, alpha_max; uint32_t push_ms, assist_ms; bool push_seen_after_stop; float push_at_end_plus_300ms; } PRes;
+/* climb to 9 mm and stay elevated; speeds: moving 40 mm/s until stall_from_s, then 0 until move_from_s, then 40 */
+static PRes prun(double stall_from_s, double move_from_s, double level_at_s, double stop_at_s, double pause_at_s, double total_s) {
+    PRes r = { 0 }; RampAssist a; ra_reset(&a); uint64_t t0 = 90000000; double end_t = -1; float push_prev = 0;
+    for (int k = 0; k < (int)(total_s * 100); ++k) {
+        double t = k * 0.01; uint64_t now = t0 + (uint64_t)k * 10000u; int i = k / 2;
+        RampAssistInput in = base_in(now);
+        in.run_active = !(stop_at_s > 0 && t >= stop_at_s); in.auto_mode = !(pause_at_s > 0 && t >= pause_at_s);
