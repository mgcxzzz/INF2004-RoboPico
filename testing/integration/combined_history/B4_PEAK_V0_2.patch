+} RampAssist02;
+
+static inline void ra02_interval_reset(RampAssist02 *a) {
+    a->int_max_mm = -128; a->int_min_mm = 127;
+    a->int_valid = a->int_invalid = a->int_run = a->int_longest = 0;
+}
+static inline void ra02_reset(RampAssist02 *a) {
+    *a = (RampAssist02){0};
+    a->pending_event = 0xff;
+    ra02_interval_reset(a);
+}
+static inline int16_t ra02_abs16(int16_t v) { return (int16_t)(v < 0 ? -v : v); }
+/* v0.2: median of the last (up to) 3 valid |heights|; a single dip or spike
+ * cannot move it. Cleared on any invalid sample. */
+static inline int16_t ra02_median_push(int16_t *m, uint8_t *n, int16_t v) {
+    m[0] = m[1]; m[1] = m[2]; m[2] = v; if (*n < 3) (*n)++;
+    if (*n < 3) return v;
+    int16_t a = m[0], b = m[1], c = m[2];
+    return (a > b) ? ((b > c) ? b : (a > c ? c : a)) : ((a > c) ? a : (b > c ? c : b));
+}
+static inline uint8_t ra02_inc8(uint8_t v) { return (uint8_t)(v < 255 ? v + 1 : 255); }
