+static inline void ra02_end(RampAssist02 *a, uint8_t reason, uint64_t now, bool latch) {
+    if (!a->assisting) return;
+    a->assisting = false;
+    a->active_ms = (uint32_t)((now - a->active_since_us) / 1000u);
+    a->last_end = reason;
+    if (latch) a->latched = true;
+    a->over_ticks = a->drop_ticks = 0;
+    a->pending_event = RA02_EVT_END;
+}
+static inline void ra02_end_episode(RampAssist02 *a) {
+    a->latched = false; a->episode_us = 0; a->peak_mm = 0;
+}
+
+/* One call per control step (10 ms). Returns the alpha (milli) to apply to
+ * both wheels this step. Ineligible states force 0 immediately (the existing
+ * controller is being reset or left at that moment anyway). */
+static inline float ramp_assist02_step(RampAssist02 *a, const RampAssist02Input *in) {
+    const uint64_t now = in->now_us;
+    if (!in->run_active) {                     /* Stop, ESTOP, fault, run end */
+        ra02_end(a, RA02_END_STOPPED, now, false);
+        uint8_t ev = a->pending_event, acts = a->activations, end = a->last_end;
+        uint32_t ms = a->active_ms;
+        bool had = a->have_sample;
+        ra02_reset(a);                           /* a new run starts a fresh state */
+        a->pending_event = ev; a->activations = acts; a->last_end = end; a->active_ms = ms;
+        a->have_sample = had;
+        return 0.0f;
+    }
+    /* new Buddy4 sample? */
+    if (in->tilt_seq != a->last_seq || !a->have_sample) {
+        bool fresh = !a->have_sample || in->tilt_seq != a->last_seq;
+        a->have_sample = true; a->last_seq = in->tilt_seq;
+        if (fresh) {
+            a->last_sample_us = in->tilt_us; a->last_valid = in->tilt_valid; a->last_mm = in->tilt_mm;
+            if (in->tilt_valid) {
+                const int16_t h = in->tilt_mm, mag = ra02_abs16(h);
+                const int8_t sg = (int8_t)(h > 0 ? 1 : h < 0 ? -1 : 0);
+                a->invalid_since_us = 0;
+                a->int_valid = ra02_inc8(a->int_valid);
+                if (h > a->int_max_mm) a->int_max_mm = h;
+                if (h < a->int_min_mm) a->int_min_mm = h;
+                if (mag >= RA02_ENTER_MM) { a->int_run = ra02_inc8(a->int_run); if (a->int_run > a->int_longest) a->int_longest = a->int_run; }
+                else a->int_run = 0;
+                const int16_t hf = ra02_median_push(a->med, &a->med_n, mag);   /* v0.2 filtered |h| */
+                /* level band (filtered): ends activations after 100 ms, episodes after 200 ms */
+                if (hf <= RA02_EXIT_MM) {
+                    a->level_ticks = ra02_inc8(a->level_ticks);
+                    if (!a->level_since_us) a->level_since_us = in->tilt_us;
+                    if (in->tilt_us - a->level_since_us >= RA02_LEVEL_REARM_US && !a->assisting) ra02_end_episode(a);
+                } else { a->level_ticks = 0; a->level_since_us = 0; }
+                if (a->assisting) {
+                    if (hf > a->peak_mm) a->peak_mm = hf;
+                    if (a->level_ticks >= RA02_EXIT_TICKS) ra02_end(a, RA02_END_LEVEL, now, false);
+                    else {
+                        bool falling = a->peak_mm >= RA02_DESCENT_MIN_PEAK &&
+                                       (int32_t)hf * RA02_DESCENT_DEN <= (int32_t)a->peak_mm * RA02_DESCENT_NUM;
+                        a->drop_ticks = falling ? ra02_inc8(a->drop_ticks) : 0;
+                        if (a->drop_ticks >= RA02_DESCENT_TICKS) ra02_end(a, RA02_END_DESCENT, now, true);
+                    }
+                } else if (!a->latched && in->auto_mode && in->following && a->episode_us < RA02_TIMEOUT_US) {
+                    if (mag >= RA02_ENTER_MM && (a->over_ticks == 0 || sg == a->sign)) {
+                        a->sign = sg; a->over_ticks = ra02_inc8(a->over_ticks);
+                    } else a->over_ticks = 0;
+                    if (a->over_ticks >= RA02_ENTER_TICKS) {
+                        a->assisting = true; a->active_since_us = now; a->peak_mm = hf > mag ? mag : hf;
+                        a->drop_ticks = a->level_ticks = 0;
+                        a->activations = ra02_inc8(a->activations);
+                        a->pending_event = RA02_EVT_ACTIVATE;
+                    }
+                } else a->over_ticks = 0;
+            } else {
+                a->int_invalid = ra02_inc8(a->int_invalid); a->int_run = 0; a->med_n = 0;
+                a->over_ticks = 0; a->level_ticks = 0; a->level_since_us = 0;
+                if (!a->invalid_since_us) a->invalid_since_us = in->tilt_us ? in->tilt_us : 1;
+            }
+        }
+    }
+    /* time-based terminations */
+    if (a->assisting) {
+        if (!in->auto_mode) ra02_end(a, RA02_END_PAUSED, now, false);
+        else if (!in->following) ra02_end(a, RA02_END_NOT_FOLLOWING, now, false);
+        else if (now - a->last_sample_us > RA02_STALE_US) ra02_end(a, RA02_END_STALE, now, false);
+        else if (a->invalid_since_us && now - a->invalid_since_us >= RA02_INVALID_US) ra02_end(a, RA02_END_INVALID, now, false);
