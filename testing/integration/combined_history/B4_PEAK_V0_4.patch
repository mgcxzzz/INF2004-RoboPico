+/* ---------- H: v0.5 tilt floor ---------- */
+typedef struct { int floor_end_events, activations; float floor_max, floor_at[64]; bool floor_after_stop; double floor_off_t; } FRes;
+/* tilt profile h(ts) in mm; speeds fixed 40 mm/s (moving) */
+typedef int16_t (*tilt_fn)(double ts);
+static int16_t tf_ramp_flat(double ts) { return ts < 0.2 ? 0 : ts < 0.5 ? (int16_t)(4 + (ts - 0.2) * 16) : ts < 2.0 ? 9 : ts < 2.3 ? (int16_t)(9 - (ts - 2.0) * 30) : 0; }
+static int16_t tf_stuck(double ts) { return ts < 0.2 ? 0 : ts < 0.5 ? (int16_t)(4 + (ts - 0.2) * 16) : 9; }
+static FRes frun(tilt_fn f, double total_s, double stop_at, double pause_at, double invalid_from, double invalid_to, bool skip) {
+    FRes r = { 0 }; RampAssist a; ra_reset(&a); uint64_t t0 = 50000000; r.floor_off_t = -1; bool was_on = false;
+    for (int k = 0; k < (int)(total_s * 100); ++k) {
+        double t = k * 0.01; int i = k / 2; double ts = i * 0.02; uint64_t now = t0 + (uint64_t)k * 10000u;
+        RampAssistInput in = base_in(now);
+        in.run_active = !(stop_at > 0 && t >= stop_at); in.auto_mode = !(pause_at > 0 && t >= pause_at);
+        bool inv = invalid_to > 0 && ts >= invalid_from && ts < invalid_to;
+        in.tilt_seq = (uint32_t)i + 1; in.tilt_us = t0 + (uint64_t)i * 20000u; in.tilt_valid = !inv; in.tilt_mm = inv ? 0 : f(ts);
+        in.tilt_skip = inv && skip;
+        (void)ramp_assist_step(&a, &in);
+        if (a.pending_event == RA_EVT_FLOOR_END) ++r.floor_end_events;
+        if (a.pending_event == RA_EVT_ACTIVATE) ++r.activations;
+        a.pending_event = 0xff;
+        if (a.floor_pwm > r.floor_max) r.floor_max = a.floor_pwm;
+        if (k % 10 == 0 && k / 10 < 64) r.floor_at[k / 10] = a.floor_pwm;
+        if (((stop_at > 0 && t >= stop_at) || (pause_at > 0 && t >= pause_at)) && a.floor_pwm > 0) r.floor_after_stop = true;
+        if (was_on && !a.floor_on && r.floor_off_t < 0) r.floor_off_t = t;
+        was_on = a.floor_on;
+    }
+    return r;
+}
+static int test_floor(void) {
+    FRes r = frun(tf_ramp_flat, 4.0, 0, 0, 0, 0, false);
+    printf("tilt floor: max %.0f PWM, on until %.2f s (flat from 2.3 s), floor-end events %d\n", r.floor_max, r.floor_off_t, r.floor_end_events);
+    CHECK(r.activations == 1 && fabsf(r.floor_max - RA_FLOOR_PWM) < 0.01f, "floor rises to 300 PWM from activation");
+    CHECK(r.floor_off_t >= 2.3 && r.floor_off_t <= 2.6 && r.floor_end_events == 1, "floor holds through crest/descent and ends ~100 ms after flat (not at the descent rule)");
+    CHECK(r.floor_at[30] < 0.01f, "floor ramped out after flat");
+    r = frun(tf_stuck, 8.0, 0, 0, 0, 0, false);
+    CHECK(r.floor_off_t >= 5.2 && r.floor_off_t <= 5.4, "stuck tilted: floor ends at the 5 s budget (from activation)");
+    r = frun(tf_stuck, 3.0, 1.5, 0, 0, 0, false);
+    CHECK(!r.floor_after_stop, "Stop removes the floor at once");
